{
  "name": "@lode/app-daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "lode-daemon": "./dist/bin/lode-daemon.js"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "prebuild": "npm run clean",
    "build": "tsc",
    "test": "vitest run",
