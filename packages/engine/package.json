{
  "name": "@lode/engine",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "prebuild": "npm run clean",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:projection-rebuild": "tsx tests/benchmark/projection-rebuild.benchmark.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@lode/sdk": "file:../sdk",
    "@lode/system-schema": "file:../system-schema",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/bip39": "^2.3.0",
    "buffer": "^6.0.3",
    "loro-crdt": "^1.11.0"
  },
  "devDependencies": {
    "@lode/engine-platform-desktop": "file:../engine-platform-desktop",
    "@types/node": "^20.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
