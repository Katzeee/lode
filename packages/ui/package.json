    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@lode/design-system-catalog": "file:../design-system-catalog",
    "@lode/design-tokens": "file:../design-tokens",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "19.2.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3"
  }
}
