{
  "name": "@lode/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "prebuild": "npm run clean",
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@lode/design-system-catalog": "file:../design-system-catalog",
    "@lode/design-tokens": "file:../design-tokens",
    "@tiptap/core": "^3.31.1",
    "@tiptap/extension-bold": "^3.31.1",
    "@tiptap/extension-code": "^3.31.1",
    "@tiptap/extension-document": "^3.31.1",
    "@tiptap/extension-italic": "^3.31.1",
    "@tiptap/extension-paragraph": "^3.31.1",
    "@tiptap/extension-text": "^3.31.1",
    "@tiptap/react": "^3.31.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "electron": "41.10.7",
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
