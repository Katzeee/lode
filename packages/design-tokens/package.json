{
  "name": "@lode/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "prebuild": "npm run clean",
    "build": "node scripts/generate.mjs && tsc",
    "typecheck": "node scripts/generate.mjs --source-only && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
