{
  "name": "lode-workspace",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <27.0.0"
  },
  "workspaces": [
    "packages/*",
    "packages/ipc/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@lode/logger && npm run build --workspace=@lode/protocol && npm run build --workspace=@lode/engine && npm run build --workspace=@lode/client && npm run build --workspace=@lode/daemon && npm run build --workspace=@lode/app-cli",
    "test": "npm run test --workspaces --if-present",
    "test:engine": "npm run test --workspace=@lode/engine",
    "test:daemon": "npm run test --workspace=@lode/daemon",
    "test:app-cli": "npm run test --workspace=@lode/app-cli",
    "typecheck": "npm run typecheck:build && npm run typecheck:test",
    "typecheck:build": "npm run typecheck --workspaces --if-present",
    "typecheck:test": "npm run typecheck:test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test:proposal-routing": "vitest run experiments/proposal-routing-feasibility",
    "test:proposal-authority": "vitest run experiments/proposal-authority-model",
    "benchmark:proposal-authority": "node --expose-gc node_modules/tsx/dist/cli.mjs experiments/proposal-authority-model/benchmark.ts",
    "benchmark:proposal-retention": "node --expose-gc node_modules/tsx/dist/cli.mjs experiments/proposal-authority-model/retention-benchmark.ts",
    "test:proposal-reconcile-scheduler": "vitest run experiments/proposal-reconcile-scheduler",
    "test:proposal-fact-causality": "vitest run experiments/proposal-fact-causality",
    "test:proposal-fact-admission": "vitest run experiments/proposal-fact-admission-lifecycle",
    "benchmark:proposal-reconcile-scheduler": "node --expose-gc node_modules/tsx/dist/cli.mjs experiments/proposal-reconcile-scheduler/benchmark.ts",
    "verify": "npm run build && npm run typecheck && npm run lint && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node-import": "^1.2.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.60.1"
  },
  "allowScripts": {
    "@bufbuild/buf@1.71.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
