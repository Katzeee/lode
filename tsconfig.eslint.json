{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx"
  },
  "include": [
    "apps/cli/src/**/*.ts",
    "apps/cli/tests/**/*.ts",
    "apps/mobile/src/**/*.ts",
    "apps/mobile/src/**/*.tsx",
    "apps/desktop/src/**/*.ts",
    "apps/desktop/src/**/*.tsx",
    "apps/desktop/src/**/*.cts",
    "packages/node-endpoint/src/**/*.ts",
    "packages/desktop-client/src/**/*.ts",
    "packages/desktop-client/tests/**/*.ts",
    "packages/protocol/src/**/*.ts",
    "packages/protocol/tests/**/*.ts",
    "packages/sdk/src/**/*.ts",
    "packages/sdk/tests/**/*.ts",
    "packages/system-schema/src/**/*.ts",
    "packages/daemon/src/**/*.ts",
    "packages/daemon/tests/**/*.ts",
    "packages/engine/src/**/*.ts",
    "packages/engine/tests/**/*.ts",
    "packages/engine-platform-desktop/src/**/*.ts",
    "packages/engine-platform-mobile/src/**/*.ts",
    "packages/design-tokens/src/**/*.ts",
    "packages/design-system-catalog/src/**/*.ts",
    "packages/ui/src/**/*.ts",
    "packages/ui/src/**/*.tsx",
    "packages/application/src/**/*.ts",
    "packages/application/src/**/*.tsx"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "packages/engine/tests/benchmark/**"]
}
